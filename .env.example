# Backend/.env.example
#
# Copy to Backend/.env and fill in real values.
# The .env file is already in your .gitignore — confirmed from screenshot.
# NEVER commit the actual .env file.
#
# Migration stack:
#   Before (Railway): Railway PostgreSQL + Railway Redis + Railway app host
#   After  (Render):  Neon PostgreSQL  + Upstash Redis  + Render app host

# ─── PostgreSQL — Neon (keep your existing Neon DB — no data migration) ───────
# Get from: console.neon.tech → your project → Connection string
# Use "Connection pooling" URL for production (better connection handling)
#
# If your app uses SQLAlchemy ASYNC (AsyncSession, asyncpg):
DATABASE_URL=postgresql+asyncpg://your_user:your_password@ep-cool-name-123456.us-east-2.aws.neon.tech/applyflow?sslmode=require

# If your app uses SQLAlchemy SYNC (Session, psycopg2):
# DATABASE_URL=postgresql://your_user:your_password@ep-cool-name-123456.us-east-2.aws.neon.tech/applyflow?sslmode=require

# ─── Redis — Upstash (replaces Railway Redis plugin) ─────────────────────────
# Get from: console.upstash.com → your database → Details → REDIS_URL
#
# ⚠️  Must be rediss:// (double s = TLS). Upstash REQUIRES TLS.
#     If you use redis:// (no TLS) Upstash will reject the connection.
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_DB_NAME.upstash.io:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a new key (run this in terminal):
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use the same key across deploys — changing it invalidates all existing tokens.
SECRET_KEY=replace-with-64-char-hex-string-from-command-above

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── App ─────────────────────────────────────────────────────────────────────
# Local dev: development
# Render:    production  (set via render.yaml — don't need to set manually)
ENVIRONMENT=development

# ─── Render reverse-proxy fix ─────────────────────────────────────────────────
# Set to * on Render so slowapi reads real client IPs from X-Forwarded-For.
# Local dev: leave as 127.0.0.1 (default)
# Render:    set via render.yaml as "*" — don't need to set manually locally
FORWARDED_ALLOW_IPS=127.0.0.1
